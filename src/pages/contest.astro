---
// Internal imports
import BaseLayout from '@layouts/BaseLayout.astro';

const SUBMIT_URL = 'https://forms.gle/mxqKihQ2KBPmd9Gd9';
---

<BaseLayout
  title="60-Second Film Contest"
  description="Make and submit a film 60 seconds or less during the month of October. All skill levels welcome, a video from your phone is totally fine. Prizes for the winners."
  keywords="Asheville film contest, 60 second film contest, short film competition, AVLFilm contest"
>
  <section class="hero">
    <div class="timer" role="img" aria-label="60 seconds">
      <div class="timer-screen"><span class="timer-num">0<span class="colon blink">:</span>60</span></div>
      <span class="timer-unit">seconds</span>
    </div>
    <h1>AVL Film 60-Second Film Contest</h1>
    <p class="tagline">A one-minute filmmaking challenge, all October long.</p>
    <div class="cta">
      <a href={SUBMIT_URL} target="_blank" rel="noopener" class="btn-submit">Submit Your Film</a>
      <span class="deadline">🎃 Due 11:59pm on Halloween 🎃</span>
    </div>
  </section>

  <div class="what-is-it">
    <div class="pill"><span class="pill-emoji">🎥</span>Any skill level, any genre</div>
    <div class="pill"><span class="pill-emoji">🎞️</span>Submit as many as you like</div>
    <div class="pill"><span class="pill-emoji">🏆</span>Prizes for the winners</div>
  </div>

  <p>
    Inspired by the <a href="https://48hourfilm.com/asheville" target="_blank" rel="noopener">48 Hour Film Project</a>,
    it's a fun creative challenge for everyone. Never made a film before? This is the perfect excuse to try, and a video
    from your phone is totally fine. We can't wait to see what people do with sixty seconds of storytelling.
  </p>

  <p>
    Submit by midnight on 🎃 Halloween 🎃. Winners are announced about a week later, and the films screen at our next
    showcase.
  </p>

  <h2>FAQ</h2>

  <div class="faq">
    <div class="faq-item">
      <h3>Who is eligible to enter and win?</h3>
      <p>Anyone in North Carolina, from people who have never made a film before to people who do it professionally. All are welcome. Let's have fun.</p>
    </div>

    <div class="faq-item">
      <h3>What are the prizes?</h3>
      <p>Prizes are TBA, so stay tuned!</p>
    </div>

    <div class="faq-item">
      <h3>Why 60 seconds?</h3>
      <p>Long enough to tell a story, short enough that anyone can pull it off in an afternoon.</p>
    </div>

    <div class="faq-item">
      <h3>Can I make more than one?</h3>
      <p>Yes! Each film should be a self-contained story.</p>
    </div>

    <div class="faq-item">
      <h3>Any tips?</h3>
      <p>Don't overthink it! While you can do multiple angles and cuts, consider that maybe it's not necessary. Plenty of people submit a oner (a single continuous shot with no cuts), and that's totally okay.</p>
    </div>

    <div class="faq-item">
      <h3>Are credits included in the total length?</h3>
      <p>No. Ideally your credits will fit on a single screen and not scroll. Credits should, of course, not be longer than the film itself!</p>
    </div>
  </div>

  <h2>What are the requirements?</h2>

  <ul class="requirements">
    <li>Make a film no more than 60 seconds in length. 16:9 aspect ratio (sideways on your phone)</li>
    <li>Can be any genre</li>
    <li>Include "This was made for the AVLFilm.com 60-second film contest 2026" at the end of your credits</li>
    <li>Submit by 11:59pm on October 31st</li>
    <li>Have fun</li>
  </ul>

  <div class="cta cta-bottom">
    <a href={SUBMIT_URL} target="_blank" rel="noopener" class="btn-submit">Submit Your Film</a>
    <span class="deadline">🎃 Due 11:59pm on Halloween 🎃</span>
  </div>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=VT323&display=swap");

  .hero {
    text-align: center;
    padding: 2.5rem 1.5rem 3rem;
    margin: 0 0 2.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
  }

  .timer {
    text-align: center;
    margin: 0 auto 1.5rem;
  }

  .timer-screen {
    display: inline-block;
    background: #05100a;
    border-radius: 12px;
    padding: 0.4rem 1.75rem 0.2rem;
    box-shadow: inset 0 0 24px rgba(0, 255, 120, 0.12);
  }

  .timer-num {
    font-family: "VT323", monospace;
    font-size: 6rem;
    line-height: 0.9;
    color: #4ade80;
    text-shadow: 0 0 12px rgba(74, 222, 128, 0.6);
  }

  .blink {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blink { animation: none; }
  }

  .timer-unit {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.6rem;
    padding-left: 0.3em;
  }

  .hero h1 {
    color: #fff;
    margin: 0.5rem 0 0.25rem;
    font-size: 1.6rem;
  }

  .hero .tagline {
    color: rgba(255, 255, 255, 0.9);
    font-style: italic;
    font-size: 1.1rem;
    margin: 0 0 1.75rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .btn-submit {
    display: inline-block;
    background: #fff;
    color: var(--color-primary-dark);
    text-decoration: none;
    font-weight: 800;
    padding: 0.875rem 2.25rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  .deadline {
    font-weight: 700;
    color: #fff;
  }

  .cta-bottom {
    justify-content: flex-start;
    margin: 2rem 0 1rem;
  }

  .cta-bottom .btn-submit {
    background: var(--color-primary);
    color: #fff;
  }

  .cta-bottom .deadline {
    color: #f97316;
  }

  .what-is-it {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 0 0 2.5rem;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: #f3f4ff;
    border: 1px solid #dfe1fb;
    font-weight: 600;
    color: #1f2937;
  }

  .pill-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }

  .faq {
    margin: 1.5rem 0 2.5rem;
  }

  .faq-item {
    padding: 1.1rem 1.25rem;
    margin-bottom: 1rem;
    border-radius: var(--radius-lg);
    background: #fafafe;
    border: 1px solid #ecedf9;
    border-left: 4px solid var(--color-primary);
  }

  .faq-item h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    color: var(--color-primary-dark);
  }

  .faq-item p {
    margin: 0;
  }

  .requirements {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .requirements li {
    position: relative;
    padding: 0.5rem 0 0.5rem 2rem;
  }

  .requirements li::before {
    content: '🎬';
    position: absolute;
    left: 0;
    top: 0.4rem;
  }

  @media (max-width: 768px) {
    .timer {
      width: 150px;
      height: 150px;
    }

    .timer-num {
      font-size: 3.25rem;
    }
  }
</style>
