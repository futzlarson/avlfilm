---
// Internal imports
import BaseLayout from '@layouts/BaseLayout.astro';
import Countdown from '@components/Countdown.astro';
import TimerFont from '@components/TimerFont.astro';
import { CONTEST_DEADLINE, CONTEST_START, CONTEST_SUBMIT_URL } from '@config/contest';

// Once entries close, swap the submit buttons for a pointer to the screening.
const closed = Date.now() > new Date(CONTEST_DEADLINE).getTime();

const PROMPTS = [
  { icon: '🚪', title: 'The Threshold', text: 'Someone crosses an everyday threshold, like a doorway, bridge, creek or trail, and something subtly changes on the other side. Think of October as the space between seasons, or between worlds.' },
  { icon: '🪶', title: 'A Message From the Woods', text: 'A character finds something, like a feather, note, key, photograph or ribbon, that seems meant just for them.' },
  { icon: '🌿', title: 'The Witch Next Door', text: 'A playful documentary portrait of a totally ordinary person whose daily routines, like herbs, gardening, tarot, baking or tending animals, start to feel quietly magical.' },
  { icon: '👜', title: 'Things We Carry', text: 'Someone empties their pockets or bag onto a table. Each object reveals a small piece of who they are.' },
  { icon: '👻', title: 'The Ghost of Who I Used to Be', text: 'Someone comes across an object, photo or place tied to an earlier version of themselves. More emotional than spooky.' },
  { icon: '🧵', title: 'The Invisible Thread', text: 'Two strangers pass through the same places over the course of a day without knowing it, until their paths finally cross.' },
  { icon: '🌀', title: 'The Portal', text: 'Find a real but visually striking location, like a tunnel, old barn, foggy trail or swimming hole, and shoot it as if it leads somewhere else.' },
  { icon: '🕒', title: 'Three Knocks', text: "It's 3 a.m. and someone knocks. The whole film is 60 seconds of deciding not to open the door." },
  { icon: '🔁', title: 'The Loop', text: 'The last frame is the first frame, so the story traps the viewer.' },
  { icon: '⏪', title: 'Played Backward', text: 'Shoot it so the story only makes sense in reverse.' },
];

// Lets Google show the contest as an event in search results.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'AVL Film 60-Second Film Contest',
  description: 'Make a film 60 seconds or less during October. Open to anyone in North Carolina, all skill levels welcome.',
  startDate: CONTEST_START,
  endDate: CONTEST_DEADLINE,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'VirtualLocation', url: CONTEST_SUBMIT_URL },
  organizer: { '@type': 'Organization', name: 'AVL Film', url: 'https://avlfilm.com' },
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="60-Second Film Contest"
  description="Make a one-minute film in October for the Asheville 60-second film contest. Open to all of North Carolina. Prizes + a screening."
  keywords="Asheville film contest, 60 second film contest, North Carolina short film competition, AVL Film contest"
  ogImage="https://avlfilm.com/contest-og.jpg"
  structuredData={structuredData}
>
  <TimerFont slot="head" />
  <section class="hero">
    <div class="timer" role="img" aria-label="60 seconds">
      <div class="timer-screen"><span class="timer-num">0<span class="colon blink">:</span>60</span></div>
      <span class="timer-unit">seconds</span>
    </div>
    <h1>AVL Film 60-Second Film Contest</h1>
    <p class="tagline">A one-minute filmmaking challenge, all October long.</p>
    <div class="cta">
      {closed ? (
        <span class="deadline">Submissions are closed</span>
      ) : (
        <>
          <a href={CONTEST_SUBMIT_URL} target="_blank" rel="noopener" class="btn-submit">Submit Your Film</a>
          <span class="deadline"><span>🎃</span>Due 11:59pm on Halloween<span>🎃</span></span>
        </>
      )}
    </div>
  </section>

  {!closed && <Countdown deadline={CONTEST_DEADLINE} startAt={CONTEST_START} heading="Deadline" doneText="Submissions are closed!" />}

  <section class="screening" id="screening" aria-labelledby="screening-heading">
    <div class="screening-date" aria-hidden="true">
      <span class="dow">Sun</span>
      <span class="day">8</span>
      <span class="mon">Nov</span>
    </div>
    <div class="screening-body">
      <p class="screening-eyebrow">🎬 30 films submitted · You're invited</p>
      <h2 id="screening-heading">The Screening, Sunday Nov 8</h2>
      <p class="screening-intro">Come see every film, cheer on your friends, and meet fellow creatives.</p>
      <div class="screening-details">
        <div><span class="k"><span class="ic" aria-hidden="true">🗓️</span> When</span><span class="v">5pm mingle<br />6pm screening</span></div>
        <div><span class="k"><span class="ic" aria-hidden="true">🎥</span> What</span><span class="v">Free screening of all 30 films</span></div>
        <div><span class="k"><span class="ic" aria-hidden="true">🏠</span> Where</span><span class="v"><a href="https://www.instagram.com/apocalypseparlor/" target="_blank" rel="noopener">Apocalypse Parlor</a><br /><a class="map-btn" href="https://www.google.com/maps/search/?api=1&query=21+Young+Rd+Weaverville+NC" target="_blank" rel="noopener"><span aria-hidden="true">📍</span> 21 Young Rd, Weaverville</a></span></div>
      </div>
      <ul class="screening-notes">
        <li><span aria-hidden="true">🍺</span> BYOB, no alcohol sold</li>
        <li><span aria-hidden="true">🍿</span> Popcorn machine</li>
        <li><span aria-hidden="true">🌱</span> Bringing food? Vegan only, per the venue</li>
      </ul>
    </div>
  </section>

  <div class="what-is-it">
    <div class="pill"><span class="pill-emoji">🎥</span>Any skill level, any genre</div>
    <div class="pill"><span class="pill-emoji">🎞️</span>Submit as many as you like</div>
    <div class="pill"><span class="pill-emoji">🏆</span>Prizes and a screening</div>
  </div>

  <p>
    Inspired by the <a href="https://48hourfilm.com/asheville" target="_blank" rel="noopener">48 Hour Film Project</a>,
    it's a fun creative challenge for everyone! Never made a film before? This is the perfect excuse to try, and a video
    from your phone is totally fine. We can't wait to see what people do with sixty seconds of storytelling.
  </p>

  <p>
    Submit by midnight on 🎃 Halloween 🎃. Winners are announced at a screening about a week after the deadline.
  </p>

  <h2 id="prompts">This Year's Prompts</h2>
  <p class="prompts-intro">Totally optional. Use one, combine a few, or skip them and make whatever you want.</p>

  <div class="prompts">
    {PROMPTS.map((p) => (
      <div class="prompt">
        <span class="prompt-icon" aria-hidden="true">{p.icon}</span>
        <div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="constraints">
    <p class="constraints-label">&gt; EXTRA_CHALLENGE<span class="term-cursor" aria-hidden="true">_</span></p>
    <p class="constraints-intro">Add an optional constraint to any prompt, or to no prompt at all. Use one, stack a few, or skip them.</p>
    <div class="constraint-list">
      <div class="constraint">
        <span class="constraint-icon" aria-hidden="true">🎥</span>
        <h3>One take</h3>
        <p>Shoot the whole film in a single continuous shot, with no cuts.</p>
      </div>
      <div class="constraint">
        <span class="constraint-icon" aria-hidden="true">🙈</span>
        <h3>No faces</h3>
        <p>Never show a face on screen. Tell the story through hands, objects, places or shadows.</p>
      </div>
      <div class="constraint">
        <span class="constraint-icon" aria-hidden="true">🤐</span>
        <h3>No dialogue</h3>
        <p>Nobody speaks. Let the images, sound and music carry the story.</p>
      </div>
    </div>
  </div>

  <h2>FAQ</h2>

  <div class="faq">
    <div class="faq-item">
      <h3>Who is eligible to enter and win?</h3>
      <p>Anyone in North Carolina, from people who have never made a film before to people who do it professionally. All are welcome. Let's have fun!</p>
    </div>

    <div class="faq-item">
      <h3>What are the prizes?</h3>
      <p>Prizes include:</p>
      <ul class="prize-list">
        <li>A 30-minute headshot session with Charly Louise, owner of <a href="https://www.venusrisingmedia.com/" target="_blank" rel="noopener">Venus Rising Media</a> (a $250 value)</li>
        <li>Gift cards to <a href="https://www.instagram.com/harvestrecordsavl/" target="_blank" rel="noopener">Harvest Records</a>, <a href="https://www.instagram.com/oddscafe/" target="_blank" rel="noopener">Odd's Cafe</a> and <a href="https://www.instagram.com/shopclad/" target="_blank" rel="noopener">Clad</a></li>
        <li>Swag from <a href="https://www.instagram.com/walkavl/" target="_blank" rel="noopener">Walk AVL</a></li>
      </ul>
    </div>

    <div class="faq-item">
      <h3>Can I make more than one?</h3>
      <p>Yes! Each film should be a self-contained story.</p>
    </div>

    <div class="faq-item">
      <h3>Why 60 seconds?</h3>
      <p>Because 10 and 20 seconds was ridiculously short.</p>
    </div>

    <div class="faq-item">
      <h3>Any tips?</h3>
      <p>Keep it simple. You can do multiple angles and cuts, but look for places to simplify. Some people submit a oner (a single continuous take), and that's totally okay.</p>
    </div>

    <div class="faq-item">
      <h3>Are credits included in the total length?</h3>
      <p>No. Ideally your credits will fit on a single screen and not scroll. Credits should, of course, not be longer than the film itself!</p>
    </div>

    <div class="faq-item">
      <h3>How do I find cast &amp; crew?</h3>
      <p>For crew, browse our <a href="/directory">directory</a>. For cast, check our partner <a href="https://www.screenartistsco-op.com/contact-us/" target="_blank" rel="noopener">Screen Artists Co-op</a>.</p>
    </div>

    <div class="faq-item">
      <h3>Any examples I can see?</h3>
      <p><a href="https://www.youtube.com/watch?v=80OXl2r-rzo" target="_blank" rel="noopener">Watch the films</a> from our 20-second contest back in 2023!</p>
    </div>
  </div>

  <h2>What are the requirements?</h2>

  <ul class="requirements">
    <li>Make a film no more than 60 seconds in length. 16:9 aspect ratio (sideways on your phone) preferred</li>
    <li>Shoot and edit it during October 2026. No films made before the contest started</li>
    <li>Any genre, with or without <a href="#prompts">this year's prompts</a></li>
    <li>Include "This was made for the AVLFilm.com 60-second film contest 2026" at the end of your credits</li>
    <li>Submit by 11:59pm on October 31st</li>
    <li class="weird">Get weird with it!</li>
  </ul>

  {!closed && (
    <div class="cta cta-bottom">
      <a href={CONTEST_SUBMIT_URL} target="_blank" rel="noopener" class="btn-submit">Submit Your Film</a>
      <span class="deadline"><span>🎃</span>Due 11:59pm on Halloween<span>🎃</span></span>
    </div>
  )}

  <p class="follow">Follow <a href="https://instagram.com/avlfilm" target="_blank" rel="noopener">@avlfilm</a> for updates.</p>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 2.5rem 1.5rem 3rem;
    margin: 0 0 2.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
  }

  .timer {
    text-align: center;
    margin: 0 auto 1.5rem;
  }

  .timer-screen {
    position: relative;
    display: inline-block;
    background: #05100a;
    border-radius: 12px;
    padding: 0.4rem 1.75rem 0.2rem;
    box-shadow: inset 0 0 24px rgba(0, 255, 120, 0.12);
    overflow: hidden;
  }

  /* CRT scanlines */
  .timer-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25) 0,
      rgba(0, 0, 0, 0.25) 1px,
      transparent 1px,
      transparent 3px
    );
    border-radius: 12px;
  }

  .timer-num {
    font-family: "VT323", monospace;
    font-size: 6rem;
    line-height: 0.9;
    color: #4ade80;
    text-shadow: 0 0 12px rgba(74, 222, 128, 0.6);
  }

  .blink {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blink { animation: none; }
  }

  .timer-unit {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.6rem;
    padding-left: 0.3em;
  }

  .hero h1 {
    color: #fff;
    margin: 0.5rem 0 0.25rem;
    font-size: 1.6rem;
  }

  .hero .tagline {
    color: rgba(255, 255, 255, 0.9);
    font-style: italic;
    font-size: 1.1rem;
    margin: 0 0 1.75rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .btn-submit {
    display: inline-block;
    background: #fff;
    color: var(--color-primary-dark);
    text-decoration: none;
    font-weight: 800;
    padding: 0.875rem 2.25rem;
    line-height: 1.5rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  .deadline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.35);
    /* Match .btn-submit height: same padding/line-height, minus this pill's 1px border */
    padding: calc(0.875rem - 1px) 1.5rem;
    line-height: 1.5rem;
    border-radius: 999px;
  }

  .cta-bottom {
    justify-content: flex-start;
    margin: 2rem 0 1rem;
  }

  .cta-bottom .btn-submit {
    background: var(--color-primary);
    color: #fff;
  }

  .cta-bottom .deadline {
    color: #c2410c;
    background: #fff7ed;
    border-color: #fed7aa;
  }

  .follow {
    margin-top: 1.5rem;
    color: var(--color-text-light);
  }

  /* Event callout styled like a ticket, so it stands apart from the contest info. */
  .screening {
    display: flex;
    gap: 1.75rem;
    align-items: stretch;
    margin: 0 0 2.5rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #2a1838 0%, #4a2766 100%);
    color: #f3ecda;
    box-shadow: 0 10px 30px rgba(42, 24, 56, 0.25);
  }

  .screening-date {
    flex: 0 0 auto;
    width: 7rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #f3ecda;
    color: #2a1838;
    padding: 0.75rem 0;
    line-height: 1;
  }

  .screening-date .dow,
  .screening-date .mon {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .screening-date .mon {
    color: #c2410c;
  }

  .screening-date .day {
    font-size: 3.5rem;
    font-weight: 900;
    margin: 0.2rem 0;
  }

  .screening-body {
    flex: 1;
    min-width: 0;
  }

  .screening-eyebrow {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fbbf24;
  }

  .screening h2 {
    margin: 0 0 0.35rem;
    color: #fff;
    font-size: 1.7rem;
  }

  .screening-intro {
    margin: 0 0 1.1rem;
    color: rgba(243, 236, 218, 0.9);
  }

  .screening-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .screening-details > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .screening-details .ic {
    font-size: 1.15rem;
    vertical-align: -0.1em;
  }

  .screening-details .map-btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: #fbbf24;
    color: #2a1838;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .screening-details .map-btn:hover {
    background: #fcd34d;
  }

  .screening-details .k {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fbbf24;
  }

  .screening-details .v {
    font-weight: 600;
    line-height: 1.35;
  }

  .screening-details a {
    color: #fff;
    text-decoration: underline;
  }

  .screening-notes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .screening-notes li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.92rem;
  }

  .screening-notes li span {
    font-size: 1.2rem;
    line-height: 1;
    margin-right: 0.15rem;
  }

  @media (max-width: 760px) {
    .screening {
      flex-direction: column;
      gap: 1.1rem;
      padding: 1.25rem;
    }

    .screening-date {
      flex-direction: row;
      gap: 0.6rem;
      width: auto;
      align-self: flex-start;
      padding: 0.5rem 1rem;
    }

    .screening-date .day {
      font-size: 1.8rem;
      margin: 0;
    }

    .screening-details {
      grid-template-columns: 1fr;
    }
  }

  .what-is-it {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 0 0 2.5rem;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: #f3f4ff;
    border: 1px solid #dfe1fb;
    font-weight: 600;
    color: #1f2937;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pill:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(102, 126, 234, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .pill:hover { transform: none; }
  }

  .pill-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }

  .prompts-intro {
    color: var(--color-text-light);
    margin: -0.5rem 0 1.25rem;
  }

  .prompts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0 0 1.25rem;
  }

  /* Dark CRT panel so the optional challenges read as a separate "bonus" layer. */
  .constraints {
    position: relative;
    margin: 0 0 2.5rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: #05100a;
    color: #d1fae5;
    overflow: hidden;
  }

  .constraints::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px);
  }

  .constraints-label {
    margin: 0 0 0.25rem;
    font-family: "VT323", monospace;
    font-size: 1.6rem;
    line-height: 1;
    color: #4ade80;
    text-shadow: 0 0 8px rgba(74, 222, 128, 0.5);
  }

  .term-cursor {
    animation: blink 1s steps(1) infinite;
  }

  .constraints-intro {
    margin: 0 0 1.25rem;
    color: rgba(209, 250, 229, 0.85);
  }

  .constraint-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }

  .constraint {
    padding: 1rem 1.1rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(74, 222, 128, 0.35);
    background: rgba(74, 222, 128, 0.06);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .constraint:hover {
    transform: translateY(-3px);
    border-color: rgba(74, 222, 128, 0.7);
  }

  .constraint-icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  .constraint h3 {
    margin: 0.5rem 0 0.25rem;
    font-family: "VT323", monospace;
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #4ade80;
    text-shadow: 0 0 8px rgba(74, 222, 128, 0.45);
  }

  .constraint p {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(209, 250, 229, 0.85);
  }

  @media (max-width: 768px) {
    .constraint-list {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .constraint:hover { transform: none; }
    .term-cursor { animation: none; }
  }

  .prompt {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: #fafafe;
    border: 1px solid #ecedf9;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .prompt:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(102, 126, 234, 0.15);
  }

  .prompt-icon {
    flex: 0 0 2.6rem;
    height: 2.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    border-radius: 50%;
    background: #eef0ff;
  }

  .prompt h3 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
    color: var(--color-primary-dark);
  }

  .prompt p {
    margin: 0;
    font-size: 0.95rem;
  }

