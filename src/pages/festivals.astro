const today = new Date();
today.setHours(0, 0, 0, 0);

function isPast(f: Festival): boolean {
  return f.date !== null && new Date(f.date) < today;
}

// Within a section: upcoming (by date) → dates TBA → past (by date).
function rank(f: Festival): number {
  if (f.date === null) return 1;
  return isPast(f) ? 2 : 0;
}

function sortFestivals(list: Festival[]): Festival[] {
  return [...list].sort((a, b) => {
    const ra = rank(a);
    const rb = rank(b);
    if (ra !== rb) return ra - rb;
    if (a.date && b.date) return a.date.localeCompare(b.date);
    return 0;
  });
}

const bySection = SECTIONS.map((section) => ({
  section,
  items: sortFestivals(festivals.filter((f) => f.section === section)),
}));
---

<BaseLayout
  title="Film Festivals around Asheville, NC"
  description="Discover film festivals near Asheville, NC - from local competitions to major regional events within 250 miles."
  keywords="Asheville film festivals, NC film festivals, submit film festival, independent film festivals, regional film festivals"
>
  <h1>Film Festivals Near Asheville</h1>
  <p class="tagline">From hometown showcases to road-trip-worthy regional festivals</p>

  <p>
    Whether you're looking to submit your latest short, challenge yourself with a 48-hour sprint,
    or take a weekend trip to premiere your feature, the Southeast has festivals for every filmmaker
    and every stage of the journey. Here's your guide to festivals within 250 miles of Asheville,
    sorted by how far you'll need to drive (or not drive at all). And if you're wondering how to get your film into festivals, <a href="/info">we've got you covered</a>.
  </p>

  <div class="highlights">
    <div class="highlight-box">
      <h3>🚗 Closest Traditional Festivals</h3>
      <ul>
        <li><a href="#tryon-international">Tryon International</a> - 45 miles</li>
        <li><a href="#reedy-reels">Reedy Reels</a> (Greenville, SC) - 65 miles</li>
        <li><a href="#riverrun">RiverRun</a> (Winston-Salem) - 100 miles</li>
      </ul>
    </div>

    <div class="highlight-box">
      <h3>⭐ Major Regional Festivals</h3>
      <ul>
        <li><a href="#atlanta-film-festival">Atlanta Film Festival</a> - 200 mi</li>
        <li><a href="#scad-savannah">SCAD Savannah</a> - 250 mi</li>
        <li><a href="#chattanooga-film-festival">Chattanooga Film Festival</a> - 160 mi</li>
        <li><a href="#virginia-film-festival">Virginia Film Festival</a> - 200 mi</li>
      </ul>
    </div>

    <div class="highlight-box">
      <h3>🎯 Special Categories</h3>
      <ul>
        <li><a href="#backcountry">Backcountry</a> - Human-powered adventure</li>
        <li><a href="#reedy-reels">Reedy Reels</a> - Best SC Upstate Film</li>
        <li><a href="#crimson-screen">Crimson Screen</a> - Horror specialization</li>
        <li><a href="#afrosouth">AfroSouth</a> - African descent stories</li>
        <li><a href="#goombay">Goombay</a> - Pan-African, Black stories</li>
        <li><a href="#jewish-film">Asheville Jewish</a> - Jewish stories & culture</li>
      </ul>
    </div>
  </div>

  {bySection.map(({ section, items }) => (
    <section class="grid-2col festivals">
      <h2 class="grid-full">{section}</h2>
      {items.map((f) => (
        <div class={`card festival${isPast(f) ? ' past' : ''}`} id={f.anchor}>
          <h3>
            {f.url ? (
              <a href={f.url} target="_blank" rel="noopener">{f.name}</a>
            ) : (
              f.name
            )}
          </h3>
          <div class="meta">
            {isPast(f) && <span class="past-badge">Past</span>}{f.dateLabel} • {f.location}
          </div>
          <p>{f.description}</p>
        </div>
      ))}
    </section>
  ))}
</BaseLayout>

<style>
  .tagline {
    font-size: 1.25rem;
    color: var(--color-text-light);
    font-style: italic;
    margin: 0;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0 3rem;
  }

  .highlight-box {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid #e5e7eb;
  }

  .highlight-box:nth-child(1) {
    background: linear-gradient(135deg, #60a5fa20 0%, #3b82f640 100%);
    border-color: #93c5fd;
  }

  .highlight-box:nth-child(2) {
    background: linear-gradient(135deg, #f59e0b20 0%, #f59e0b40 100%);
    border-color: #fbbf24;
  }

  .highlight-box:nth-child(3) {
    background: linear-gradient(135deg, #ec489920 0%, #ec489940 100%);
    border-color: #f472b6;
  }

  .highlight-box h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #1f2937;
    font-size: 1.1rem;
  }

  .highlight-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .highlight-box li {
    padding: 0.4rem 0;
    color: #4b5563;
  }

  .highlight-box strong {
    color: #1f2937;
  }

  .highlight-box a {
    color: #1f2937;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .highlight-box a:hover {
    color: var(--color-primary);
  }

  .festivals {
    margin-bottom: 3rem;
  }

  .festivals h2 {
    color: #1f2937;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .festivals {
    align-items: start;
  }

  .festivals h2 {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .festivals h2:first-of-type {
    margin-top: 0;
  }

  .festival h3 {
    margin-bottom: 0.5rem;
  }

  .meta {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .festival.past {
    opacity: 0.6;
  }

  .past-badge {
    display: inline-block;
    background: #6b7280;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.1rem 0.4rem;
    border-radius: 0.25rem;
    margin-right: 0.5rem;
    vertical-align: middle;
  }


  @media (max-width: 768px) {
    .hero h1 {
      font-size: 1.75rem;
    }

    .tagline {
      font-size: 1rem;
    }

    .highlights {
      grid-template-columns: 1fr;
    }

    .festival h3 {
      font-size: 1.15rem;
    }
  }
</style>
